DATABASE_URL="postgresql://postgres:password@localhost:5432/golfapp"
JWT_SECRET="change-this-to-a-long-random-secret-before-deploying"
PORT=3001
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Number of proxies in front of the app (usually 1 on Vercel/Render/Fly/Heroku).
# Leave UNSET locally. Without it, every user shares one rate-limit bucket
# because req.ip resolves to the proxy rather than the client.
TRUST_PROXY=1
