generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     Int                      @id @default(autoincrement())
  email                  String                   @unique
  passwordHash           String?
  googleId               String?                  @unique
  name                   String
  emailVerified          Boolean                  @default(false)
  verificationToken      String?                  @unique
  passwordResetToken     String?                  @unique
  passwordResetExpires   DateTime?
  hasCompletedOnboarding Boolean                  @default(false)
  createdAt              DateTime                 @default(now())
  rounds                 Round[]
  refreshTokens          RefreshToken[]
  linkedHandicap         LinkedHandicap?
  sentRequests           Friendship[]             @relation("requester")
  receivedRequests       Friendship[]             @relation("addressee")
  pushSubscriptions      PushSubscription[]
  createdCompetitions    Competition[]            @relation("competitionCreator")
  competitionEntries     CompetitionParticipant[]
  competitionRounds      CompetitionRound[]
  createdTeeTimes        TeeTime[]                @relation("teeTimeCreator")
  teeTimeEntries         TeeTimeParticipant[]
  roundReactions         RoundReaction[]
  roundComments          RoundComment[]
  courseReviews          CourseReview[]
  achievements           Achievement[]
  taggedInRounds         RoundPartner[]
  createdInviteLinks     InviteLink[]             @relation("inviteLinkCreator")
  inviteAcceptances      InviteAcceptance[]       @relation("inviteAcceptances")
  subscription           Subscription?
}

// ── Billing / Entitlements ───────────────────────────────────────────────────
// Subscription is optional today: no rows are created, every user resolves to
// FREE via getUserTier(). When billing is wired (see backend/src/lib/features.ts),
// rows are populated by the Stripe webhook handler and the existing middleware
// + FeatureGate component start enforcing automatically.

enum SubscriptionTier {
  FREE
  PRO
  SOCIETY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               Int                @unique
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Benchmarks ───────────────────────────────────────────────────────────────
// Precomputed anonymous cohort distributions for GET /rounds/benchmarks.
// One row per (band, metric). `summary` holds ONLY aggregate statistics —
// percentile breakpoints (p5..p95) and the median — never raw per-user values
// or any user identifier, so the table itself can never leak who's in a cohort.
// Refreshed lazily on read when older than the TTL (no cron in this repo).
model BenchmarkSnapshot {
  id         Int      @id @default(autoincrement())
  band       String   // "0-5" | "5-10" | ... | "30+" | "plus" | "all"
  metric     String   // BenchmarkMetric key, e.g. "scoreToPar"
  summary    Json     // { percentiles: { "5": n, "10": n, ..., "95": n } }
  sampleSize Int      // number of USERS (not rounds) in the distribution
  computedAt DateTime @default(now())

  @@unique([band, metric])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  // requesterId is already covered by the unique prefix above; addresseeId is
  // not, yet the friend-graph lookup (OR requesterId/addresseeId) runs on
  // nearly every authenticated request.
  @@index([addresseeId])
}

model LinkedHandicap {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  source         String   // "golf_australia", "ghin", "manual"
  externalId     String?  // GolfLink number, GHIN number, etc.
  handicapIndex  Float
  playerName     String?  // Name returned from lookup
  clubName       String?  // Club returned from lookup
  lastSynced     DateTime @default(now())
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id           Int           @id @default(autoincrement())
  name         String
  externalId   String? @unique
  courseRating  Float?
  slopeRating  Int?
  holes        Hole[]
  rounds       Round[]
  competitions Competition[]
  teeTimes     TeeTime[]
  reviews      CourseReview[]
}

model Hole {
  id        Int         @id @default(autoincrement())
  number    Int
  par       Int
  distance  Int
  courseId  Int
  course    Course      @relation(fields: [courseId], references: [id])
  scores    RoundHole[]

  @@unique([courseId, number])
}

model Round {
  id                    Int                @id @default(autoincrement())
  shareId               String?            @unique
  playedAt              DateTime           @default(now())
  completedAt           DateTime?
  lastScoredAt          DateTime?
  startNotificationSent Boolean            @default(false)
  userId                Int
  courseId               Int
  user                  User               @relation(fields: [userId], references: [id])
  course                Course             @relation(fields: [courseId], references: [id])
  roundHoles            RoundHole[]
  competitionRounds     CompetitionRound[]
  reactions             RoundReaction[]
  comments              RoundComment[]
  review                CourseReview?
  achievements          Achievement[]
  partners              RoundPartner[]

  @@index([userId, completedAt])
  @@index([lastScoredAt])
}

model RoundPartner {
  id        String   @id @default(uuid())
  roundId   Int
  userId    Int
  createdAt DateTime @default(now())
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([userId])
  @@index([roundId])
}

model Achievement {
  id         String   @id @default(uuid())
  userId     Int
  type       String
  unlockedAt DateTime @default(now())
  roundId    Int?
  metadata   Json?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  round      Round?   @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@unique([userId, type])
  @@index([userId, unlockedAt])
}

model CourseReview {
  id              String   @id @default(uuid())
  courseId        Int
  userId          Int
  roundId         Int      @unique
  rating          Int
  conditionRating Int?
  valueRating     Int?
  paceRating      Int?
  text            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  round           Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

// ── Reactions & Comments ─────────────────────────────────────────────────────

model RoundReaction {
  id        String   @id @default(uuid())
  roundId   Int
  userId    Int
  emoji     String
  createdAt DateTime @default(now())
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
}

model RoundComment {
  id        String   @id @default(uuid())
  roundId   Int
  userId    Int
  text      String
  createdAt DateTime @default(now())
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Comments are fetched by roundId (feed batch + per-round views) but had no
  // index, forcing a sequential scan that grows with total comment volume.
  @@index([roundId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    Int
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
}

// ── Competitions ──────────────────────────────────────────────────────────────

enum ScoringType {
  NET
  GROSS
}

enum ParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
}

model Competition {
  id               String                   @id @default(uuid())
  name             String
  creatorId        Int
  courseId          Int?
  startDate        DateTime
  endDate          DateTime
  scoringType      ScoringType              @default(NET)
  notificationSent Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  creator          User                     @relation("competitionCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  course           Course?                  @relation(fields: [courseId], references: [id])
  participants     CompetitionParticipant[]
  rounds           CompetitionRound[]
}

model CompetitionParticipant {
  id            String            @id @default(uuid())
  competitionId String
  userId        Int
  status        ParticipantStatus @default(INVITED)
  createdAt     DateTime          @default(now())
  competition   Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
}

model CompetitionRound {
  id            String      @id @default(uuid())
  competitionId String
  roundId       Int
  userId        Int
  grossScore    Int
  netScore      Float?
  scoreToPar    Int
  netScoreToPar Float?
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  round         Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, roundId])
}

// ── Tee Times ────────────────────────────────────────────────────────────────

enum TeeTimeVisibility {
  FRIENDS
  INVITED_ONLY
}

enum TeeTimeStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

enum TeeTimeParticipantStatus {
  CONFIRMED
  INVITED
  REQUESTED
  DECLINED
  WITHDRAWN
}

model TeeTime {
  id           String             @id @default(uuid())
  creatorId    Int
  courseId      Int?
  courseName   String?
  dateTime     DateTime
  spotsTotal   Int
  notes        String?
  visibility   TeeTimeVisibility  @default(FRIENDS)
  status       TeeTimeStatus      @default(OPEN)
  reminderSent Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  creator      User               @relation("teeTimeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  course       Course?            @relation(fields: [courseId], references: [id])
  participants TeeTimeParticipant[]
}

model TeeTimeParticipant {
  id        String                    @id @default(uuid())
  teeTimeId String
  userId    Int
  status    TeeTimeParticipantStatus  @default(INVITED)
  createdAt DateTime                  @default(now())
  teeTime   TeeTime                   @relation(fields: [teeTimeId], references: [id], onDelete: Cascade)
  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teeTimeId, userId])
  // "my tee times" lookups filter by userId alone, which the teeTimeId-prefixed
  // unique above cannot serve.
  @@index([userId])
}

// ── Round Scoring ─────────────────────────────────────────────────────────────

// ── Invite Links ─────────────────────────────────────────────────────────────

model InviteLink {
  id          String             @id @default(uuid())
  code        String             @unique
  creatorId   Int
  label       String?
  maxUses     Int?
  uses        Int                @default(0)
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  creator     User               @relation("inviteLinkCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  acceptances InviteAcceptance[]

  @@index([creatorId])
  @@index([creatorId, label])
}

model InviteAcceptance {
  id           String     @id @default(uuid())
  inviteLinkId String
  userId       Int
  createdAt    DateTime   @default(now())
  inviteLink   InviteLink @relation(fields: [inviteLinkId], references: [id], onDelete: Cascade)
  user         User       @relation("inviteAcceptances", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteLinkId, userId])
  @@index([userId])
}

model RoundHole {
  id               Int     @id @default(autoincrement())
  roundId          Int
  holeId           Int
  strokes          Int
  putts            Int?
  teeShotDirection String?
  teeShotDistance  String?
  approachResult   String?
  sandShots        Int?
  penalties        Int?
  hazards          Int?
  round            Round   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  hole             Hole    @relation(fields: [holeId], references: [id])

  @@unique([roundId, holeId])
}
